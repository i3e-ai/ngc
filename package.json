{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "dev": "vite",
    "lint:js": "eslint .",
    "lint:css": "stylelint '**/*.less'",
    "lint": "npm run lint:js",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "build:js": "node scripts/minify-js.js",
    "build:react": "node scripts/build-react.js",
    "watch:react": "node scripts/build-react.js --watch",
    "build": "npm run build:react && npm run build:js",
    "dev:full": "npm run watch:react & npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "stylelint": "16.23.1",
    "stylelint-config-standard": "39.0.0",
    "stylelint-config-standard-less": "^3.0.1",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
